# API
API_TOKEN=<bearer token secreto>
API_HOST=0.0.0.0
API_PORT=

# Redis Stack (RedisJSON + RediSearch, AOF activado)
REDIS_URL=

# LLM — llama.cpp server (OpenAI-compatible)
LLAMACPP_BASE_URL=
LLAMACPP_MODEL=qwen2.5-7b-instruct
LLAMACPP_TIMEOUT=60

# LLM — Gemini fallback
GEMINI_API_KEY=<key de gemini>
GEMINI_MODEL=gemini-2.0-flash-lite

# SQLite (FTS5 + sqlite-vec, mismo archivo)
SQLITE_PATH=./app/vectorstore/data/watbot.db

# Cache del modelo de embeddings (se puebla con scripts/download_model.py).
# No usar /tmp: en Linux se vacia al reiniciar.
EMBEDDING_CACHE_DIR=./models

# MySQL (buscador agent — usuario dedicado, SELECT only)
DB_HOST=
DB_NAME=
DB_BUSCADOR_USER=
DB_BUSCADOR_PASS=<pass de watbot_buscador>

# Callback hacia watbot_v2
WATBOT_CALLBACK_URL=
WATBOT_CALLBACK_TOKEN=<mismo valor que API_TOKEN>

LOG_LEVEL=INFO
